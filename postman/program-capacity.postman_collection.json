              ]
            },
            "description": "Protected. Releases exactly the USD amount stored on the Reservation — no new FX conversion occurs, and there is no request body. Marks the Reservation RELEASED and the Invoice REPAID, and restores the exact reserved USD capacity. Idempotent: repeating this call for the same Reservation returns the same Release (201) without double-restoring capacity."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {\n  pm.response.to.have.status(201);\n});",
                  "const body = pm.response.json();\nif (body.id) {\n  pm.environment.set('releaseId', body.id);\n}"
                ]
              }
            }
          ]
        },
