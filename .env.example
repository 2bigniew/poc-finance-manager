NODE_ENV=development
PORT=3000

SQL_HOST=localhost
SQL_PORT=5432
SQL_USERNAME=finance_manager
SQL_PASSWORD=finance_manager_dev_password
SQL_DBNAME=finance_manager
SQL_POOL_MAX_SIZE=10
SQL_USE_SSL=false
SQL_CERT_PATH=
SQL_LOG=false

KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=poc-finance-manager
KAFKA_CONSUMER_GROUP=poc-finance-manager

JWT_ACCESS_SECRET=change-me-local-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-local-refresh-secret
JWT_REFRESH_TTL=7d
JWT_ALGORITHM=HS256
JWT_ISSUER=poc-finance-manager
JWT_AUDIENCE=poc-finance-manager-clients
BCRYPT_ROUNDS=12

FRANKFURTER_BASE_URL=https://api.frankfurter.dev
HTTP_TIMEOUT_MS=5000
